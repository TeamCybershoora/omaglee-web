# Public frontend environment variables
VITE_APP_NAME="Omaglee"
VITE_BACKEND_API_URL="http://127.0.0.1:8000/api"

# Laravel Reverb / WebSockets Configuration (Client-Safe Public Key & Endpoint)
VITE_REVERB_APP_KEY="omaglee-app-key"
VITE_REVERB_HOST="127.0.0.1"
VITE_REVERB_PORT="8080"
VITE_REVERB_SCHEME="ws"

# WebRTC STUN / TURN Configuration
# Comma-separated STUN/TURN server URLs
VITE_ICE_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
